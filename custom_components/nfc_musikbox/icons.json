{
  "entity": {
    "sensor": {
      "current_card": {
        "default": "mdi:nfc-variant"
      },
      "position": {
        "default": "mdi:bookmark-music-outline"
      },
      "count_today": {
        "default": "mdi:counter"
      },
      "time_today": {
        "default": "mdi:timer-outline"
      }
    },
    "switch": {
      "enabled": {
        "default": "mdi:power"
      },
      "parental": {
        "default": "mdi:shield-account",
        "state": {
          "off": "mdi:shield-off-outline"
        }
      }
    },
    "select": {
      "mode": {
        "default": "mdi:book-music-outline",
        "state": {
          "simple": "mdi:music"
        }
      }
    },
    "number": {
      "start_volume": {
        "default": "mdi:volume-medium"
      },
      "max_volume": {
        "default": "mdi:volume-high"
      },
      "sleep_timer": {
        "default": "mdi:timer-sand"
      }
    },
    "binary_sensor": {
      "connected": {
        "default": "mdi:lan-connect",
        "state": {
          "off": "mdi:lan-disconnect"
        }
      }
    },
    "button": {
      "reset_limits": {
        "default": "mdi:restore"
      }
    }
  },
  "services": {
    "assign_card": {
      "service": "mdi:nfc-variant"
    },
    "remove_card": {
      "service": "mdi:nfc-variant-off"
    },
    "reset_position": {
      "service": "mdi:bookmark-remove-outline"
    },
    "play_card": {
      "service": "mdi:play"
    },
    "reset_limits": {
      "service": "mdi:restore"
    },
    "extend_limits": {
      "service": "mdi:timer-plus-outline"
    }
  }
}
